<odoo>
    <data>

        <!-- Form View -->
        <record id="view_smart_task_form" model="ir.ui.view">
            <field name="name">smart.task.form</field>
            <field name="model">smart.task</field>
            <field name="arch" type="xml">
                <form string="Smart Task">

                    <header>
                        <button name="action_start_task"
                                type="object"
                                string="Start Task"
                                class="btn-primary"
                                invisible="state != 'todo'"/>

                        <button name="action_complete_task"
                                type="object"
                                string="Complete Task"
                                class="btn-success"
                                invisible="state != 'in_progress'"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="todo,in_progress,done"/>
                    </header>

                    <sheet>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="user_id"/>
                                <field name="deadline"/>
                            </group>

                            <group>
                                <field name="priority"/>
                                <field name="time_spent" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_smart_task_list" model="ir.ui.view">
            <field name="name">smart.task.list</field>
            <field name="model">smart.task</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="deadline"/>
                    <field name="priority"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_smart_task" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">smart.task</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_smart_root"
                  name="Smart Productivity"/>

        <menuitem id="menu_smart_task"
                  name="Tasks"
                  parent="menu_smart_root"
                  action="action_smart_task"/>

    </data>
</odoo>