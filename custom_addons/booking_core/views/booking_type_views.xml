<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_booking_type_list" model="ir.ui.view">
            <field name="name">booking.type.list</field>
            <field name="model">booking.type</field>
            <field name="arch" type="xml">
                <list string="Booking Types">
                    <field name="name"/>
                    <!-- <field name="duration_hours"/>
                    <field name="website_published"/> -->
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_booking_type_form" model="ir.ui.view">
            <field name="name">booking.type.form</field>
            <field name="model">booking.type</field>
            <field name="arch" type="xml">
                <form string="Booking Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <!-- <field name="duration_hours"/>
                            <field name="color"/>
                            <field name="website_published"/> -->
                        </group>
                        <notebook>
                            <page string="Resources" name="resources">
                                <field name="resource_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <!-- <field name="capacity"/> -->
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_booking_type_search" model="ir.ui.view">
            <field name="name">booking.type.search</field>
            <field name="model">booking.type</field>
            <field name="arch" type="xml">
                <search string="Booking Types">
                    <field name="name"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <!-- <filter name="filter_published" string="Published on Website" domain="[('website_published', '=', True)]"/> -->
                </search>
            </field>
        </record>

        <record id="action_booking_type" model="ir.actions.act_window">
            <field name="name">Booking Types 12345</field>
            <field name="res_model">booking.type</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
