<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_booking_resource_list" model="ir.ui.view">
            <field name="name">booking.resource.list</field>
            <field name="model">booking.resource</field>
            <field name="arch" type="xml">
                <list string="Resources">
                    <field name="name"/>
                    <field name="booking_type_id"/>
                    <!-- <field name="capacity"/> -->
                    <!-- <field name="active"/> -->
                </list>
            </field>
        </record>

        <record id="view_booking_resource_form" model="ir.ui.view">
            <field name="name">booking.resource.form</field>
            <field name="model">booking.resource</field>
            <field name="arch" type="xml">
                <form string="Resource">
                    <sheet>
                        <group>
                            <field name="booking_type_id"/>
                            <field name="name"/>
                            <!-- <field name="capacity"/>
                            <field name="calendar_id"/> -->
                            <!-- <field name="active"/> -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_booking_resource_search" model="ir.ui.view">
            <field name="name">booking.resource.search</field>
            <field name="model">booking.resource</field>
            <field name="arch" type="xml">
                <search string="Resources">
                    <field name="name"/>
                    <field name="booking_type_id"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_booking_type" string="Booking Type" context="{'group_by': 'booking_type_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_booking_resource" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">booking.resource</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
