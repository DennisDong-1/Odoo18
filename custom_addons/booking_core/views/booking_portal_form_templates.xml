<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template 2: Simple Booking Form -->
    <template id="portal_booking_form" name="Booking Portal: New Booking">
        <t t-call="website.layout">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&amp;display=swap');
                
                .booking-portal {
                    font-family: 'Outfit', sans-serif;
                    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
                    min-height: 80vh;
                    padding: 3rem 1rem;
                }
                .form-container {
                    max-width: 600px;
                    margin: 0 auto;
                    background: rgba(255, 255, 255, 0.75);
                    backdrop-filter: blur(16px);
                    -webkit-backdrop-filter: blur(16px);
                    border: 1px solid rgba(255, 255, 255, 0.4);
                    border-radius: 24px;
                    padding: 3rem;
                    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.04);
                }
                .form-title {
                    font-weight: 700;
                    color: #1e293b;
                    font-size: 2rem;
                    letter-spacing: -0.025em;
                }
                .form-badge {
                    display: inline-block;
                    padding: 0.35rem 0.75rem;
                    border-radius: 10px;
                    font-size: 0.85rem;
                    font-weight: 500;
                    background: rgba(79, 70, 229, 0.08);
                    color: #4f46e5;
                }
                .form-group label {
                    font-weight: 500;
                    color: #475569;
                    margin-bottom: 0.5rem;
                    font-size: 0.95rem;
                }
                .form-control {
                    border-radius: 12px;
                    border: 1px solid #cbd5e1;
                    padding: 0.75rem 1rem;
                    font-family: 'Outfit', sans-serif;
                    font-size: 0.95rem;
                    color: #1e293b;
                    background-color: rgba(255, 255, 255, 0.8);
                    transition: all 0.3s ease;
                }
                .form-control:focus {
                    background-color: #fff;
                    border-color: #6366f1;
                    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
                    outline: none;
                }
                .btn-submit {
                    background: linear-gradient(to right, #4f46e5, #6366f1);
                    color: white !important;
                    font-weight: 600;
                    padding: 0.9rem 2rem;
                    border-radius: 12px;
                    border: none;
                    width: 100%;
                    transition: all 0.3s ease;
                }
                .btn-submit:hover {
                    background: linear-gradient(to right, #4338ca, #4f46e5);
                    box-shadow: 0 5px 15px rgba(79, 70, 229, 0.3);
                }
                .alert-custom {
                    background: rgba(239, 68, 68, 0.06);
                    border: 1px solid rgba(239, 68, 68, 0.2);
                    color: #ef4444;
                    padding: 1rem 1.25rem;
                    border-radius: 14px;
                    font-size: 0.95rem;
                    font-weight: 500;
                }
                .btn-back {
                    color: #64748b;
                    text-decoration: none !important;
                    font-weight: 500;
                    display: inline-flex;
                    align-items: center;
                }
                .btn-back:hover {
                    color: #1e293b;
                }
            </style>
            
            <div class="booking-portal">
                <div class="container">
                    <div class="mb-4 text-left">
                        <a href="/booking" class="btn-back">
                            <i class="fa fa-chevron-left mr-2"></i> Back to Services
                        </a>
                    </div>
                    
                    <div class="form-container text-left">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h2 class="form-title m-0">Reserve</h2>
                            <span class="form-badge" t-field="booking_type.name"/>
                        </div>
                        <t t-if="error">
                            <div class="alert alert-custom mb-4">
                                <i class="fa fa-exclamation-triangle mr-2"></i>
                                <t t-esc="error"/>
                            </div>
                        </t>
                        <form action="/booking/create" method="post" id="booking_creation_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="booking_type_id" t-att-value="booking_type.id"/>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label for="partner_name">Name</label>
                                    <input type="text" name="partner_name" id="partner_name" class="form-control" required="required" placeholder="Full Name" t-att-value="submitted_vals.get('partner_name') if submitted_vals else ''"/>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label for="partner_email">Email</label>
                                    <input type="email" name="partner_email" id="partner_email" class="form-control" required="required" placeholder="email@address.com" t-att-value="submitted_vals.get('partner_email') if submitted_vals else ''"/>
                                </div>
                            </div>
                            <div class="form-group mt-3">
                                <label for="resource_id">Services Assigned</label>
                                <select name="resource_id" id="resource_id" class="form-control" required="required">
                                    <option value="">-- Select Services --</option>
                                    <t t-foreach="resources" t-as="res">
                                        <option t-att-value="res.id" t-att-selected="int(submitted_vals.get('resource_id')) == res.id if submitted_vals and submitted_vals.get('resource_id') else False">
                                            <t t-esc="res.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6 form-group">
                                    <label for="start_datetime">Start Time</label>
                                    <input type="datetime-local" name="start_datetime" id="start_datetime" class="form-control" required="required" t-att-value="default_start"/>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label for="end_datetime">End Time</label>
                                    <input type="datetime-local" name="end_datetime" id="end_datetime" class="form-control" required="required" t-att-value="default_end"/>
                                </div>
                            </div>
                            <div class="form-group mt-3">
                                <label for="notes">Notes</label>
                                <textarea name="notes" id="notes" class="form-control" rows="3" placeholder="Special requirements..."><t t-esc="submitted_vals.get('notes') if submitted_vals else ''"/></textarea>
                            </div>
                            <button type="submit" class="btn-submit mt-4">
                                Confirm Appointment <i class="fa fa-calendar-check-o ml-2"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Client-side script to auto-fill end_datetime to 1 hour after start_datetime -->
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    const startInput = document.getElementById('start_datetime');
                    const endInput = document.getElementById('end_datetime');
                    function calculateEndTime() {
                        if (!startInput.value) return;
                        const startDate = new Date(startInput.value);
                        if (isNaN(startDate.getTime())) return;
                        
                        // Default to a 1-hour slot
                        const endDate = new Date(startDate.getTime() + (1 * 60 * 60 * 1000));
                        
                        const pad = (num) => String(num).padStart(2, '0');
                        const yyyy = endDate.getFullYear();
                        const mm = pad(endDate.getMonth() + 1);
                        const dd = pad(endDate.getDate());
                        const hh = pad(endDate.getHours());
                        const min = pad(endDate.getMinutes());
                        
                        endInput.value = `${yyyy}-${mm}-${dd}T${hh}:${min}`;
                    }
                    startInput.addEventListener('change', calculateEndTime);
                });
            </script>
        </t>
    </template>
</odoo>