<odoo>
    <data>
        <record id="view_chaitanya_wellness_service_list" model="ir.ui.view">
            <field name="name">chaitanya.wellness.service.list</field>
            <field name="model">chaitanya.wellness.service</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="duration_minutes"/>
                    <field name="slot_step_minutes"/>
                    <field name="price"/>
                    <field name="website_published"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_chaitanya_wellness_service_form" model="ir.ui.view">
            <field name="name">chaitanya.wellness.service.form</field>
            <field name="model">chaitanya.wellness.service</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="active"/>
                            <field name="website_published"/>
                        </group>
                        <group>
                            <field name="duration_minutes"/>
                            <field name="slot_step_minutes"/>
                            <field name="currency_id"/>
                            <field name="price"/>
                        </group>
                        <notebook>
                            <page>
                                <field name="description"/>
                                <field name="benefits"/>
                                <field name="provider_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_chaitanya_wellness_service" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">chaitanya.wellness.service</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>