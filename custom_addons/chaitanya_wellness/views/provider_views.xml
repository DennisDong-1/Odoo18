<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_chaitanya_wellness_provider_list" model="ir.ui.view">
            <field name="name">chaitanya.wellness.provider.list</field>
            <field name="model">chaitanya.wellness.provider</field>
            <field name="arch" type="xml">
                <list string="Therapists">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_chaitanya_wellness_provider_form" model="ir.ui.view">
            <field name="name">chaitanya.wellness.provider.form</field>
            <field name="model">chaitanya.wellness.provider</field>
            <field name="arch" type="xml">
                <form string="Therapist">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Profile" name="bio">
                                <field name="bio"/>
                            </page>
                            <page string="Services" name="services">
                                <field name="service_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Working hours" name="working_hours">
                                <field name="working_day_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="weekday"/>
                                        <field name="start_time" widget="float_time"/>
                                        <field name="end_time" widget="float_time"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_chaitanya_wellness_provider" model="ir.actions.act_window">
            <field name="name">Therapists</field>
            <field name="res_model">chaitanya.wellness.provider</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
