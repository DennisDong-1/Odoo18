<odoo>
    <data>

        <record id="view_chaitanya_wellness_service_category_list" model="ir.ui.view">
            <field name="name">chaitanya.wellness.service.category.list</field>
            <field name="model">chaitanya.wellness.service.category</field>
            <field name="arch" type="xml">
                <list string="Services"> 
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="service_count"/>
                    <field name="website_published"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_chaitanya_wellness_service_category_form" model="ir.ui.view">
            <field name="name">chaitanya.wellness.service.category.form</field>
            <field name="model">chaitanya.wellness.service.category</field>
            <field name="arch" type="xml">
                <form string="Services">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="website_published"/>
                            <field name="service_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_chaitanya_wellness_service_category" model="ir.actions.act_window">
            <field name="name">Service Categories</field>
            <field name="res_model">chaitanya.wellness.service.category</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>